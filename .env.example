# Public runtime configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets - never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
BUILDER_PREVIEW_SECRET=
BUILDER_ALLOWED_ORIGINS=http://localhost:3000
TURNSTILE_SECRET_KEY=
FORM_FINGERPRINT_SECRET=
CRON_SECRET=

# Published snapshot recovery (separate Preview and Production private stores)
BUILDER_RECOVERY_ENVIRONMENT=preview
BUILDER_RECOVERY_BLOB_TOKEN_PREVIEW=
BUILDER_RECOVERY_BLOB_TOKEN_PRODUCTION=
BUILDER_RECOVERY_MEDIA_GRANT_SECRET_PREVIEW=
BUILDER_RECOVERY_MEDIA_GRANT_SECRET_PRODUCTION=

# Live newsletter provider configuration (Production only)
# Keep every secret value in Vercel; these examples contain names only.
RESEND_SEND_API_KEY=
RESEND_MANAGEMENT_API_KEY=
RESEND_WEBHOOK_SECRET=
# Non-secret Resend resource IDs used by the read-only provider inventory audit.
RESEND_SEND_API_KEY_ID=
RESEND_MANAGEMENT_API_KEY_ID=
RESEND_AUTH_SMTP_KEY_ID=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=
NEWSLETTER_CONFIRMATION_KEYRING=
NEWSLETTER_CONFIRMATION_ACTIVE_KEY_ID=
NEWSLETTER_TEST_RECIPIENTS=
NEWSLETTER_EMAIL_ENABLED=false

# GitHub Packages install authentication is supplied as NODE_AUTH_TOKEN in CI.
# Local development can use the user-level token created by npm login.
